              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Meera\",\n  \"lastName\": \"Reddy\",\n  \"age\": 34,\n  \"gender\": \"FEMALE\",\n  \"email\": \"meera.reddy@example.com\",\n  \"phoneNumber\": \"9876500001\",\n  \"address\": {\n    \"country\": \"India\",\n    \"state\": \"Telangana\",\n    \"houseName\": \"23B, Jubilee Hills\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{patientServiceUrl}}/api/patients",
              "host": ["{{patientServiceUrl}}"],
              "path": ["api", "patients"]
            },
            "description": "Create a new patient. Gender must be one of: MALE, FEMALE, OTHER.\n\n**Validation rules:**\n- `firstName`: required (not blank)\n- `age`: required\n- `gender`: required (MALE | FEMALE | OTHER)\n- `email`: required, must be valid\n- `address.country`: required"
