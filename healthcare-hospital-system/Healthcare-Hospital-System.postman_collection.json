    {
      "name": "Appointment Service",
      "description": "Appointment booking and query. Base URL: {{appointmentServiceUrl}} (port 8482).\n\nExposes both a REST API and a GraphQL endpoint (`/graphql`).\nGraphiQL browser UI is available at: http://localhost:8482/graphiql",
      "item": [
        {
          "name": "REST API",
          "item": [
            {
              "name": "Create Appointment",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"patientId\": \"33333333-3333-3333-3333-333333333333\",\n  \"doctorId\": \"cccccccc-cccc-cccc-cccc-cccccccccccc\",\n  \"slotId\": \"33333333-0000-0000-0000-000000000002\",\n  \"reason\": \"Follow-up consultation for knee injury\",\n  \"appointmentTime\": \"2026-06-03T10:00:00\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{appointmentServiceUrl}}/api/appointment",
                  "host": ["{{appointmentServiceUrl}}"],
                  "path": ["api", "appointment"]
                },
                "description": "Book a new appointment. The service validates patient and doctor existence via gRPC calls to patient-service and doctor-service.\n\n**Fields:**\n- `patientId`: UUID of the patient\n- `doctorId`: UUID of the doctor\n- `slotId`: UUID of an AVAILABLE doctor slot\n- `reason`: reason for visit\n- `appointmentTime`: ISO 8601 datetime (e.g. `2026-06-03T10:00:00`)\n\nThis example books David Thomas with Dr. Vikram Mehta on an available slot."
              },
              "response": []
            },
            {
              "name": "Get Appointment by ID - Appointment 1",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{appointmentServiceUrl}}/api/appointment/{{appointmentId_1}}",
